rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model (all fields required unless noted):
    // users/{uid}: uid string (immutable, equals uid), createdAt timestamp.
    // users/{uid}/notebooks/{id}: uid string (immutable), name string (1-80),
    // createdAt timestamp (immutable), updatedAt timestamp.
    // users/{uid}/flashcards/{id}: uid string (immutable), notebookId string
    // (1-128, immutable), deckId string (1-128, immutable), deckTitle string
    // (1-100), front/back strings (1-2000), createdAt timestamp (immutable),
    // updatedAt timestamp.
    // users/{uid}/notes/{id}: uid string (immutable), notebookId string
    // (1-128, immutable), name string (1-100), content string (0-10000),
    // createdAt timestamp (immutable), updatedAt timestamp.
    // users/{uid}/activityDays/{YYYY-MM-DD}: dateKey string (immutable,
    // YYYY-MM-DD), createdAt timestamp.
    // users/{uid}/streak/current: currentStreak integer (1-36500),
    // lastActivityDate string (YYYY-MM-DD), updatedAt timestamp.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isRegisteredOwner(userId) {
      return isOwner(userId) &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasUserProfile(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validString(data, field, minLength, maxLength) {
      return data[field] is string &&
        data[field].size() >= minLength &&
        data[field].size() <= maxLength;
    }

    function isValidUserProfile(data, userId) {
      return hasRequiredFields(data, ['uid', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['uid', 'createdAt']) &&
        data.uid is string &&
        data.uid == userId &&
        data.createdAt is timestamp;
    }

    function isValidNotebook(data, userId) {
      return hasRequiredFields(
          data,
          ['uid', 'name', 'createdAt', 'updatedAt']
        ) &&
        hasOnlyAllowedFields(
          data,
          ['uid', 'name', 'createdAt', 'updatedAt']
        ) &&
        data.uid is string &&
        data.uid == userId &&
        validString(data, 'name', 1, 80) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFlashcard(data, userId) {
      return hasRequiredFields(
          data,
          [
            'uid',
            'notebookId',
            'deckId',
            'deckTitle',
            'front',
            'back',
            'createdAt',
            'updatedAt'
          ]
        ) &&
        hasOnlyAllowedFields(
          data,
          [
            'uid',
            'notebookId',
            'deckId',
            'deckTitle',
            'front',
            'back',
            'createdAt',
            'updatedAt'
          ]
        ) &&
        data.uid is string &&
        data.uid == userId &&
        validString(data, 'notebookId', 1, 128) &&
        validString(data, 'deckId', 1, 128) &&
        validString(data, 'deckTitle', 1, 100) &&
        validString(data, 'front', 1, 2000) &&
        validString(data, 'back', 1, 2000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNote(data, userId) {
      return hasRequiredFields(
          data,
          ['uid', 'notebookId', 'name', 'content', 'createdAt', 'updatedAt']
        ) &&
        hasOnlyAllowedFields(
          data,
          ['uid', 'notebookId', 'name', 'content', 'createdAt', 'updatedAt']
        ) &&
        data.uid is string &&
        data.uid == userId &&
        validString(data, 'notebookId', 1, 128) &&
        validString(data, 'name', 1, 100) &&
        data.content is string &&
        data.content.size() <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    function isValidActivityDay(data, dateKey) {
      return hasRequiredFields(data, ['dateKey', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['dateKey', 'createdAt']) &&
        isValidDateKey(dateKey) &&
        data.dateKey == dateKey &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    function hasActivityDayAfter(userId, dateKey) {
      let activityDayPath =
        /databases/$(database)/documents/users/$(userId)/activityDays/$(dateKey);
      return existsAfter(activityDayPath) &&
        getAfter(activityDayPath).data.dateKey == dateKey;
    }

    function isValidStreak(data, userId) {
      return hasRequiredFields(
          data,
          ['currentStreak', 'lastActivityDate', 'updatedAt']
        ) &&
        hasOnlyAllowedFields(
          data,
          ['currentStreak', 'lastActivityDate', 'updatedAt']
        ) &&
        data.currentStreak is int &&
        data.currentStreak >= 1 &&
        data.currentStreak <= 36500 &&
        isValidDateKey(data.lastActivityDate) &&
        hasActivityDayAfter(userId, data.lastActivityDate) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function ownsNotebook(userId, notebookId) {
      let notebookPath =
        /databases/$(database)/documents/users/$(userId)/notebooks/$(notebookId);
      return exists(notebookPath) && get(notebookPath).data.uid == userId;
    }

    match /users/{userId} {
      allow get: if isRegisteredOwner(userId);
      allow create, update: if isRegisteredOwner(userId) &&
      avatarId == 'current' &&
      hasRequiredFields(request.resource.data, ['photoBase64', 'updatedAt']) &&
      hasOnlyAllowedFields(request.resource.data, ['photoBase64', 'updatedAt']) &&
      request.resource.data.photoBase64 is string &&
      request.resource.data.photoBase64.matches('^data:image/jpeg;base64,.*') &&
      request.resource.data.photoBase64.size() < 150000 &&
      request.resource.data.updatedAt == request.time;
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.createdAt == request.time;

      match /notebooks/{notebookId} {
        allow read: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner();
        allow create: if isOwner(userId) &&
          hasUserProfile(userId) &&
          uidUnchanged() &&
          isValidNotebook(request.resource.data, userId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner() &&
          uidNotModified() &&
          isValidNotebook(request.resource.data, userId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner();
      }

      match /flashcards/{flashcardId} {
        allow read: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner();
        allow create: if isOwner(userId) &&
          hasUserProfile(userId) &&
          uidUnchanged() &&
          isValidFlashcard(request.resource.data, userId) &&
          ownsNotebook(userId, request.resource.data.notebookId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner() &&
          uidNotModified() &&
          isValidFlashcard(request.resource.data, userId) &&
          ownsNotebook(userId, request.resource.data.notebookId) &&
          request.resource.data.notebookId == resource.data.notebookId &&
          request.resource.data.deckId == resource.data.deckId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deckTitle', 'front', 'back', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner() &&
          ownsNotebook(userId, resource.data.notebookId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner();
        allow create: if isOwner(userId) &&
          hasUserProfile(userId) &&
          uidUnchanged() &&
          isValidNote(request.resource.data, userId) &&
          ownsNotebook(userId, request.resource.data.notebookId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner() &&
          uidNotModified() &&
          isValidNote(request.resource.data, userId) &&
          ownsNotebook(userId, request.resource.data.notebookId) &&
          request.resource.data.notebookId == resource.data.notebookId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'content', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId) &&
          hasUserProfile(userId) &&
          isDocOwner() &&
          ownsNotebook(userId, resource.data.notebookId);
      }

      match /activityDays/{dateKey} {
        allow get: if isRegisteredOwner(userId) &&
          hasUserProfile(userId);
        allow create: if isRegisteredOwner(userId) &&
          hasUserProfile(userId) &&
          isValidActivityDay(request.resource.data, dateKey);
      }

      match /streak/{streakId} {
        allow get: if isRegisteredOwner(userId) &&
          hasUserProfile(userId);
        allow create: if isRegisteredOwner(userId) &&
          hasUserProfile(userId) &&
          streakId == 'current' &&
          isValidStreak(request.resource.data, userId) &&
          request.resource.data.currentStreak == 1;
        allow update: if isRegisteredOwner(userId) &&
          hasUserProfile(userId) &&
          streakId == 'current' &&
          isValidStreak(request.resource.data, userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentStreak', 'lastActivityDate', 'updatedAt']) &&
          (
            (
              request.resource.data.lastActivityDate == resource.data.lastActivityDate &&
              request.resource.data.currentStreak == resource.data.currentStreak
            ) ||
            (
              request.resource.data.lastActivityDate != resource.data.lastActivityDate &&
              (
                request.resource.data.currentStreak == 1 ||
                request.resource.data.currentStreak == resource.data.currentStreak + 1
              )
            )
          );
          match /avatar/{avatarId} {
          allow get: if isRegisteredOwner(userId);
          allow create, update: if isRegisteredOwner(userId) &&
            avatarId == 'current' &&
            hasRequiredFields(request.resource.data, ['photoBase64', 'updatedAt']) &&
            hasOnlyAllowedFields(request.resource.data, ['photoBase64', 'updatedAt']) &&
            request.resource.data.photoBase64 is string &&
            request.resource.data.photoBase64.size() < 150000 &&
            request.resource.data.updatedAt == request.time;
        }
      }
    }
  }
}
